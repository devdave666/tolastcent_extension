# =============================================================================
# To Last Cent — cjSyncWorker environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Database (same Supabase/PostgreSQL instance as /backend) -------------
DATABASE_URL=postgres://postgres:password@localhost:5432/tolastcent
DATABASE_SSL=true

# --- CJ Affiliate GraphQL Commission Detail API ----------------------------
# Personal Access Token, generated at https://developers.cj.com under
# Account Manager > GraphQL API Tokens. Treat this like a password.
CJ_PERSONAL_ACCESS_TOKEN=replace_with_cj_pat

# Your CJ "Company ID" (the publisher account ID commissions are reported
# against) — found in the CJ Publisher dashboard account settings.
CJ_COMPANY_ID=1234567

# Override the Commission Detail GraphQL endpoint if CJ issues a new one.
CJ_GRAPHQL_ENDPOINT=https://commission-detail.api.cj.com/query

# How many hours back to query on each run. The worker is intended to run
# via cron/GitHub Actions roughly every hour, with enough overlap
# (24h lookback) that a missed run never loses a transaction.
SYNC_LOOKBACK_HOURS=24
