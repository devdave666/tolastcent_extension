# =============================================================================
# To Last Cent — Backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Server -------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the extension
# uses chrome-extension://<id>, the landing page uses your GitHub Pages URL).
CORS_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,https://devdave666.github.io

# --- Database (Supabase / PostgreSQL) ------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI, "Session" mode).
# Example: postgres://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:password@localhost:5432/tolastcent

# Set to "true" when connecting to a hosted Postgres that requires SSL
# (Supabase, RDS, etc). Local Postgres usually does not need this.
DATABASE_SSL=true

# --- Auth -----------------------------------------------------------------
# Long, random secret used to sign user session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# --- CJ Affiliate -----------------------------------------------------------
# Your CJ Affiliate Publisher ID (a.k.a. PID / Website ID), found in the CJ
# Publisher dashboard under Account > Websites.
CJ_PUBLISHER_ID=1234567

# CJ deep-link tracking domain used to build outbound redirect links.
# CJ rotates several equivalent domains — any of the following work:
# anrdoezrs.net, dpbolvw.net, jdoqocy.com, kqzyfj.com, tkqlhce.com, awltovhc.com
CJ_TRACKING_DOMAIN=www.anrdoezrs.net

# CJ Personal Access Token used by /jobs/cjSyncWorker.js to call the GraphQL
# Commission Detail API. Generate one at https://developers.cj.com under
# "Authentication" (Account Manager > GraphQL API Tokens).
CJ_PERSONAL_ACCESS_TOKEN=replace_with_cj_pat

# CJ Company ID (CID) of your own publisher account (not the advertiser),
# required by the Commission Detail GraphQL query.
CJ_COMPANY_ID=1234567
